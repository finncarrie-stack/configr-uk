---
import '../../../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pizzas = [
  { name: "Margherita", desc: "San Marzano tomato, fior di latte, fresh basil, EVOO", price: "£9.50", tag: "Classic" },
  { name: "Marinara", desc: "San Marzano tomato, garlic, oregano, EVOO (no cheese)", price: "£8.50", tag: "Vegan" },
  { name: "Diavola", desc: "Tomato, fior di latte, spicy Neapolitan salami, chilli", price: "£12.50", tag: "Spicy" },
  { name: "Prosciutto e Funghi", desc: "Tomato, mozzarella, Parma ham, chestnut mushrooms", price: "£13.50", tag: "" },
  { name: "Quattro Formaggi", desc: "Mozzarella, gorgonzola, parmesan, smoked scamorza", price: "£12.95", tag: "" },
  { name: "Nduja & Honey", desc: "Tomato, mozzarella, spicy nduja, hot honey drizzle", price: "£13.95", tag: "Chef's pick" },
  { name: "The Megapolitan", desc: "Our legendary 20\" sharing pizza — choose any two toppings", price: "£26.00", tag: "To share" },
  { name: "Giardiniera", desc: "Tomato, mozzarella, grilled courgette, peppers, aubergine", price: "£12.50", tag: "Veggie" },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Oak Fired at The Royal Oak — True Neapolitan Pizza, Beccles</title>
  <meta name="description" content="Suffolk's top pizza. Authentic wood-fired Neapolitan pizza at The Royal Oak, Beccles. Dine in, collect, or order to your table." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Karla:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet" />
  <style>
    :root{
      --green:#019247; --green-d:#017a3b; --green-l:#02a851;
      --red:#ce2a37; --red-d:#b3232f; --red-l:#e23744;
      --orange:#e66721; --cream:#FFFDF7; --ink:#2C2C2C;
    }
    * { font-family: 'Karla', system-ui, sans-serif; }
    h1,h2,h3,.font-display { font-family: 'Playfair Display', Georgia, serif; }
    html { scroll-behavior: smooth; }
    body { background: var(--cream); color: var(--ink); }

    .hero-bg{
      background:
        radial-gradient(ellipse 60% 70% at 82% 25%, rgba(230,103,33,0.16) 0%, transparent 58%),
        radial-gradient(ellipse 50% 60% at 12% 90%, rgba(1,146,71,0.10) 0%, transparent 55%),
        var(--cream);
    }
    .btn-red{ background:linear-gradient(135deg,var(--red-l),var(--red) 70%,var(--red-d)); color:#fff;
      transition:transform 200ms cubic-bezier(0.34,1.56,0.64,1),box-shadow 200ms ease; cursor:pointer; }
    .btn-red:hover{ transform:translateY(-2px); box-shadow:0 10px 28px rgba(206,42,55,0.4); }
    .btn-red:active{ transform:translateY(0); }
    .btn-red:focus-visible{ outline:3px solid #f0a0a6; outline-offset:2px; }

    .btn-green{ background:linear-gradient(135deg,var(--green-l),var(--green) 70%,var(--green-d)); color:#fff;
      transition:transform 200ms cubic-bezier(0.34,1.56,0.64,1),box-shadow 200ms ease; cursor:pointer; }
    .btn-green:hover{ transform:translateY(-2px); box-shadow:0 10px 28px rgba(1,146,71,0.38); }
    .btn-green:active{ transform:translateY(0); }

    .btn-ghost-green{ border:2px solid var(--green); color:var(--green-d); transition:all 180ms ease; cursor:pointer; }
    .btn-ghost-green:hover{ background:var(--green); color:#fff; }

    .nav-link{ position:relative; transition:color 150ms ease; color:var(--ink); }
    .nav-link::after{ content:''; position:absolute; bottom:-3px; left:0; width:0; height:2px; background:var(--red); transition:width 220ms ease; }
    .nav-link:hover{ color:var(--red); }
    .nav-link:hover::after{ width:100%; }

    .menu-card{ transition:transform 200ms ease; }
    .menu-card:hover{ transform:translateX(4px); }

    .tricolore{ background:linear-gradient(90deg,var(--green) 0 33.3%,#fff 33.3% 66.6%,var(--red) 66.6% 100%); }

    @keyframes float{ 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
    .float{ animation:float 6s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce){ *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important} }
  </style>
</head>
<body class="antialiased overflow-x-hidden">

  <!-- NAV -->
  <header class="absolute top-0 inset-x-0 z-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 flex items-center justify-between h-20">
      <a href="#top" class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-full flex items-center justify-center" style="background:var(--green);">
          <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8 2 5 5 5 9c0 1.5.5 2.5 1 3.5L12 22l6-9.5c.5-1 1-2 1-3.5 0-4-3-7-7-7zm0 4a3 3 0 110 6 3 3 0 010-6z"/></svg>
        </div>
        <div class="leading-none">
          <p class="font-display text-lg font-bold" style="color:var(--ink);">Oak Fired</p>
          <p class="text-[10px] tracking-[0.2em] uppercase" style="color:var(--green-d);">at The Royal Oak</p>
        </div>
      </a>
      <nav class="hidden md:flex items-center gap-8">
        <a href="#menu" class="nav-link text-sm font-semibold">Menu</a>
        <a href="#story" class="nav-link text-sm font-semibold">Our Story</a>
        <a href="#visit" class="nav-link text-sm font-semibold">Visit</a>
      </nav>
      <a href={`${base}/demos/oak-fired/order`} class="btn-red text-sm font-bold px-5 py-2.5 rounded-full flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        Order Online
      </a>
    </div>
  </header>

  <!-- HERO -->
  <section id="top" class="hero-bg relative min-h-screen flex items-center overflow-hidden">
    <div aria-hidden="true" class="absolute -right-24 top-1/2 -translate-y-1/2 w-[560px] h-[560px] rounded-full float hidden lg:block" style="background:radial-gradient(circle at 42% 42%, rgba(230,103,33,0.30) 0%, rgba(206,42,55,0.12) 40%, transparent 70%);filter:blur(6px);"></div>
    <div aria-hidden="true" class="absolute right-20 top-1/2 -translate-y-1/2 w-80 h-80 rounded-full border-2 hidden lg:block" style="border-color:rgba(1,146,71,0.15);"></div>

    <div class="max-w-7xl mx-auto px-6 lg:px-10 relative z-10 py-32">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 bg-white border rounded-full pl-1.5 pr-4 py-1.5 mb-7 shadow-sm" style="border-color:rgba(1,146,71,0.25);">
          <span class="tricolore w-8 h-4 rounded-sm border border-stone-200"></span>
          <span class="text-xs font-bold tracking-wide uppercase" style="color:var(--green-d);">Suffolk's Top Pizza — Tripadvisor</span>
        </div>
        <h1 class="font-display text-5xl lg:text-7xl font-bold leading-[1.05] mb-6" style="color:var(--ink);">
          True Neapolitan,<br><span class="italic" style="color:var(--red);">wood-fired</span> in Beccles.
        </h1>
        <p class="text-lg leading-relaxed mb-9 max-w-lg" style="color:#5a5a5a;">
          Slow-proved dough, San Marzano tomatoes and a blistering oak-fired oven. Honest Italian pizza in the heart of a proper Suffolk pub.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href={`${base}/demos/oak-fired/order`} class="btn-red font-bold px-8 py-4 rounded-full text-sm flex items-center gap-2">
            Order for collection or table
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="#menu" class="btn-ghost-green font-bold px-8 py-4 rounded-full text-sm">View the menu</a>
        </div>
        <div class="flex flex-wrap gap-8 mt-12">
          {[["4.6★","399+ reviews"],["450°","Oak-fired oven"],["35","Ravensmere, Beccles"]].map(([a,b]) => (
            <div>
              <p class="font-display text-2xl font-bold leading-none mb-1" style="color:var(--green);">{a}</p>
              <p class="text-xs uppercase tracking-wide" style="color:#8a8a8a;">{b}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="tricolore absolute bottom-0 inset-x-0 h-1"></div>
  </section>

  <!-- ORDER CTA STRIP -->
  <section style="background:var(--green);">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-5 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        <p class="font-semibold text-white">Order from your phone — collect at the bar or have it brought to your table.</p>
      </div>
      <a href={`${base}/demos/oak-fired/order`} class="bg-white text-sm font-bold px-6 py-2.5 rounded-full hover:bg-stone-100 transition-colors duration-150 whitespace-nowrap" style="color:var(--green-d);">Start your order →</a>
    </div>
  </section>

  <!-- STORY -->
  <section id="story" class="py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <img src="https://placehold.co/640x520/019247/FFFFFF?text=The+Oak-Fired+Oven" alt="Our oak-fired oven" class="rounded-3xl w-full shadow-xl" width="640" height="520">
        <div class="absolute -bottom-6 -right-6 bg-white rounded-2xl px-6 py-4 shadow-xl hidden sm:block border border-stone-100">
          <p class="font-display text-3xl font-bold leading-none" style="color:var(--red);">60s</p>
          <p class="text-xs text-stone-500 mt-1">to cook, at 450°C</p>
        </div>
      </div>
      <div>
        <span class="text-xs font-bold uppercase tracking-[0.2em]" style="color:var(--green-d);">Our Story</span>
        <h2 class="font-display text-4xl lg:text-5xl font-bold mt-3 mb-6 leading-tight" style="color:var(--ink);">Dough that takes its time.</h2>
        <p class="text-stone-600 leading-relaxed mb-5">We proof our dough for 48 hours before it ever sees the oven. That patience is what gives our pizza its light, airy, blistered crust — the hallmark of a true Neapolitan base.</p>
        <p class="text-stone-600 leading-relaxed mb-8">Everything is cooked in our oak-fired oven in under 90 seconds, sealing in the flavour of the freshest Italian ingredients. It's pizza the way Naples intended — served in a warm, welcoming Suffolk pub.</p>
        <div class="grid grid-cols-2 gap-4">
          {[
            ["48hr","Slow-proved dough"],
            ["San Marzano","DOP tomatoes"],
            ["Fior di latte","Fresh daily"],
            ["Oak wood","Real fire, real flavour"],
          ].map(([a,b]) => (
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0" style="background:rgba(1,146,71,0.12);">
                <svg class="w-4 h-4" style="color:var(--green-d);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <div>
                <p class="font-display font-bold leading-tight" style="color:var(--ink);">{a}</p>
                <p class="text-xs text-stone-500">{b}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- MENU -->
  <section id="menu" class="py-28" style="background:linear-gradient(180deg,#FFFDF7,#FFF6EC);">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-[0.2em]" style="color:var(--red);">The Menu</span>
        <h2 class="font-display text-4xl lg:text-5xl font-bold mt-3" style="color:var(--ink);">Our Pizzas</h2>
        <p class="text-stone-500 mt-4 max-w-md mx-auto">Hand-stretched, oak-fired, and topped with the best of Italy. Gluten-free bases available.</p>
        <div class="tricolore w-24 h-1 rounded-full mx-auto mt-5"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-1 max-w-4xl mx-auto">
        {pizzas.map(p => (
          <div class="menu-card flex items-baseline gap-4 py-5 border-b border-stone-200">
            <div class="flex-1">
              <div class="flex items-center gap-2.5 mb-1">
                <h3 class="font-display text-xl font-bold" style="color:var(--ink);">{p.name}</h3>
                {p.tag && <span class="text-[10px] font-bold uppercase tracking-wide rounded-full px-2 py-0.5" style="color:var(--green-d);border:1px solid rgba(1,146,71,0.4);">{p.tag}</span>}
              </div>
              <p class="text-sm text-stone-500 leading-relaxed">{p.desc}</p>
            </div>
            <div class="font-display text-lg font-bold whitespace-nowrap" style="color:var(--red);">{p.price}</div>
          </div>
        ))}
      </div>
      <div class="text-center mt-14">
        <a href={`${base}/demos/oak-fired/order`} class="btn-red inline-flex items-center gap-2 font-bold px-8 py-4 rounded-full text-sm">
          Order now — collection or table
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- VISIT -->
  <section id="visit" class="py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 grid lg:grid-cols-2 gap-14 items-start">
      <div>
        <span class="text-xs font-bold uppercase tracking-[0.2em]" style="color:var(--green-d);">Visit Us</span>
        <h2 class="font-display text-4xl lg:text-5xl font-bold mt-3 mb-8" style="color:var(--ink);">Find The Royal Oak</h2>
        <div class="space-y-6">
          {[
            {t:"Address", l:["The Royal Oak, 35 Ravensmere","Beccles, Suffolk, NR34 9DH"], i:"M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z"},
            {t:"Reservations", l:["01502 710111"], i:"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"},
            {t:"Opening Hours", l:["Wed – Thu: 5pm – 9pm","Fri – Sat: 12pm – 10pm","Sun: 12pm – 8pm","Mon & Tue: Closed"], i:"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"},
          ].map(b => (
            <div class="flex gap-4">
              <div class="w-11 h-11 rounded-full flex items-center justify-center flex-shrink-0" style="background:rgba(1,146,71,0.12);">
                <svg class="w-5 h-5" style="color:var(--green-d);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d={b.i}/></svg>
              </div>
              <div>
                <p class="font-display font-bold mb-1" style="color:var(--ink);">{b.t}</p>
                {b.l.map(line => <p class="text-sm text-stone-600">{line}</p>)}
              </div>
            </div>
          ))}
        </div>
        <div class="flex gap-3 mt-9">
          <a href={`${base}/demos/oak-fired/order`} class="btn-red font-bold px-6 py-3 rounded-full text-sm">Order online</a>
          <a href="tel:01502710111" class="btn-ghost-green font-bold px-6 py-3 rounded-full text-sm">Call to book</a>
        </div>
      </div>
      <div class="rounded-3xl overflow-hidden shadow-xl border border-stone-100">
        <img src="https://placehold.co/640x560/019247/FFFFFF?text=Map+%E2%80%94+Ravensmere%2C+Beccles" alt="Map to The Royal Oak, Beccles" class="w-full h-full object-cover" width="640" height="560">
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer style="background:var(--green-d);" class="py-14">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/15">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-full flex items-center justify-center bg-white/15">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8 2 5 5 5 9c0 1.5.5 2.5 1 3.5L12 22l6-9.5c.5-1 1-2 1-3.5 0-4-3-7-7-7zm0 4a3 3 0 110 6 3 3 0 010-6z"/></svg>
          </div>
          <div>
            <p class="font-display text-lg font-bold text-white">Oak Fired</p>
            <p class="text-[10px] tracking-[0.2em] text-white/70 uppercase">at The Royal Oak, Beccles</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="#" aria-label="Facebook" class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center hover:bg-white/30 transition-colors duration-150">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg>
          </a>
          <a href={`${base}/demos/oak-fired/order`} class="btn-red text-sm font-bold px-5 py-2 rounded-full">Order Online</a>
        </div>
      </div>
      <p class="text-center text-xs text-white/70 mt-8">© 2026 Oak Fired at The Royal Oak · 35 Ravensmere, Beccles, Suffolk NR34 9DH · 01502 710111</p>
    </div>
  </footer>

  <!-- CONFIGR DEMO BANNER -->
  <div style="background:linear-gradient(135deg,#1565C0,#0D47A1);position:fixed;bottom:0;left:0;right:0;z-index:9999;padding:10px 24px;display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;">
    <span style="font-size:13px;font-weight:600;color:white;">Demo built by <strong>Configr</strong> — a free preview of what your website could look like</span>
    <a href={`${base}/contact`} style="font-size:12px;font-weight:700;color:#1B2B4B;background:white;padding:6px 14px;border-radius:8px;white-space:nowrap;">Get this website →</a>
  </div>
  <div style="height:52px;"></div>

</body>
</html>
