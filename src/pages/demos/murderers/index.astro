          <div class="panel-title">📅 This Week's Rota</div>
        </div>
        <div class="panel-body">
          <table>
            <thead><tr><th>Staff</th><th>Role</th><th>Hours</th><th>Status</th></tr></thead>
            <tbody>
              <tr><td>Phil C.</td><td>Manager</td><td>48h</td><td><span class="pill pill-green">Confirmed</span></td></tr>
              <tr><td>Sarah K.</td><td>Bar</td><td>36h</td><td><span class="pill pill-amber">OT flag</span></td></tr>
              <tr><td>Tom W.</td><td>Bar</td><td>32h</td><td><span class="pill pill-green">Confirmed</span></td></tr>
              <tr><td>Lucy B.</td><td>Kitchen</td><td>28h</td><td><span class="pill pill-green">Confirmed</span></td></tr>
              <tr><td>Marcus R.</td><td>Kitchen</td><td>24h</td><td><span class="pill pill-green">Confirmed</span></td></tr>
