---
// The Murderers — Management System demo, built by Configr
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Murderers — Management System</title>
<style>
  :root {
    --bg: #f4f6f4;
    --surface: #4d7855;
    --card: #ffffff;
    --border: #dde8de;
    --gold: #4d7855;
    --gold-light: #5d9068;
    --red: #c0392b;
    --green: #2a7a3b;
    --text: #1e2d1e;
    --muted: #6b8a6e;
    --amber: #c8922a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Georgia', serif; min-height: 100vh; }

  /* Header */
  .header {
    background: var(--surface);
    border-bottom: 2px solid var(--gold);
    padding: 16px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header-left { display: flex; align-items: center; gap: 16px; }
  .logo { font-size: 22px; font-weight: bold; color: #ffffff; letter-spacing: 1px; }
  .logo span { color: rgba(255,255,255,0.75); font-size: 13px; font-family: sans-serif; font-weight: normal; display: block; letter-spacing: 0; margin-top: 1px; }
  .badge { background: #ffffff; color: var(--gold); font-size: 11px; font-family: sans-serif; padding: 3px 8px; border-radius: 3px; font-weight: bold; }
  .header-right { font-family: sans-serif; font-size: 13px; color: rgba(255,255,255,0.7); }
  .header-right strong { color: #ffffff; }

  /* Nav */
  .nav {
    background: #ffffff;
    border-bottom: 1px solid var(--border);
    padding: 0 28px;
    display: flex;
    gap: 4px;
  }
  .nav-tab {
    padding: 12px 18px;
    font-family: sans-serif;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .nav-tab:hover { color: var(--text); }
  .nav-tab.active { color: var(--gold); border-bottom-color: var(--gold); }

  /* Main */
  .main { padding: 24px 28px; max-width: 1300px; }

  /* Section */
  .section { display: none; }
  .section.active { display: block; }

  /* Summary cards */
  .summary-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px; }
  .summary-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 18px 20px;
  }
  .summary-card .label { font-family: sans-serif; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
  .summary-card .value { font-size: 28px; color: var(--gold); font-weight: bold; }
  .summary-card .sub { font-family: sans-serif; font-size: 12px; color: var(--muted); margin-top: 4px; }
  .summary-card .up { color: var(--green); }
  .summary-card .down { color: var(--red); }

  /* Panel */
  .panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 6px;
    margin-bottom: 20px;
    overflow: hidden;
  }
  .panel-header {
    background: #f0f5f0;
    border-bottom: 1px solid var(--border);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .panel-title { font-size: 15px; color: var(--gold); font-weight: bold; }
  .panel-body { padding: 20px; }

  /* Table */
  table { width: 100%; border-collapse: collapse; font-family: sans-serif; font-size: 13px; }
  th { text-align: left; padding: 8px 12px; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid var(--border); }
  td { padding: 10px 12px; border-bottom: 1px solid var(--border); color: var(--text); }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: rgba(200,146,42,0.05); }

  /* Pill */
  .pill {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: bold;
    font-family: sans-serif;
  }
  .pill-green { background: rgba(42,122,59,0.2); color: #4caf6e; border: 1px solid rgba(42,122,59,0.4); }
  .pill-amber { background: rgba(212,118,10,0.2); color: #e09030; border: 1px solid rgba(212,118,10,0.4); }
  .pill-red { background: rgba(155,32,32,0.2); color: #e05050; border: 1px solid rgba(155,32,32,0.4); }
  .pill-blue { background: rgba(42,90,160,0.2); color: #6090e0; border: 1px solid rgba(42,90,160,0.4); }

  /* Grid 2-col */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

  /* Shift grid */
  .shift-grid { display: grid; grid-template-columns: 120px repeat(7, 1fr); gap: 2px; font-family: sans-serif; font-size: 12px; }
  .shift-grid .day-header { text-align: center; padding: 8px 4px; color: var(--muted); font-size: 11px; text-transform: uppercase; }
  .shift-grid .staff-name { padding: 8px; color: var(--text); display: flex; align-items: center; }
  .shift-cell {
    padding: 6px 4px;
    border-radius: 4px;
    text-align: center;
    font-size: 11px;
    cursor: default;
  }
  .shift-on { background: rgba(42,122,59,0.25); color: #4caf6e; border: 1px solid rgba(42,122,59,0.3); }
  .shift-off { background: #f4f6f4; color: var(--muted); border: 1px solid var(--border); }
  .shift-leave { background: rgba(212,118,10,0.2); color: #e09030; border: 1px solid rgba(212,118,10,0.3); }

  /* Alert */
  .alert {
    border-radius: 6px;
    padding: 12px 16px;
    margin-bottom: 12px;
    font-family: sans-serif;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .alert-red { background: rgba(155,32,32,0.15); border: 1px solid rgba(155,32,32,0.4); color: #e07070; }
  .alert-amber { background: rgba(212,118,10,0.15); border: 1px solid rgba(212,118,10,0.4); color: #e09030; }
  .alert-green { background: rgba(42,122,59,0.15); border: 1px solid rgba(42,122,59,0.4); color: #4caf6e; }
  .alert-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .dot-red { background: #e05050; }
  .dot-amber { background: #e09030; }
  .dot-green { background: #4caf6e; }

  /* Payroll summary */
  .payroll-breakdown { font-family: sans-serif; font-size: 13px; }
  .payroll-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); }
  .payroll-row:last-child { border-bottom: none; }
  .payroll-row .amt { font-weight: bold; }
  .payroll-row .ni { color: var(--amber); }
  .payroll-total { display: flex; justify-content: space-between; padding: 12px 0 0; font-size: 16px; font-weight: bold; color: var(--gold); }

  /* Progress bar */
  .progress-bar { background: var(--border); border-radius: 4px; height: 6px; margin-top: 6px; overflow: hidden; }
  .progress-fill { height: 100%; border-radius: 4px; background: var(--gold); transition: width 0.5s; }
  .progress-fill.red { background: var(--red); }
  .progress-fill.amber { background: var(--amber); }

  /* Btn */
  .btn {
    background: var(--gold);
    color: var(--bg);
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-family: sans-serif;
    font-size: 12px;
    font-weight: bold;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn:hover { background: var(--gold-light); }
  .btn-outline {
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--gold);
  }
  .btn-outline:hover { background: rgba(200,146,42,0.1); }
  .btn-sm { padding: 4px 10px; font-size: 11px; }

  /* Configr footer */
  .configr-footer {
    margin-top: 32px;
    padding: 16px 20px;
    background: var(--gold);
    border: 1px solid var(--gold);
    border-radius: 6px;
    font-family: sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.8);
    text-align: center;
  }
  .configr-footer strong { color: #ffffff; }
</style>
</head>
<body>

<div class="header">
