<!-- Cart Overlay -->
<div class="cart-overlay" id="cartOverlay">
  <div class="cart-sheet">
    <div class="cart-handle"></div>
    <div class="cart-title">Your Order — Table 7</div>
    <div id="cartItems"></div>
    <div class="cart-section-divider">Any notes for the kitchen?</div>
    <textarea class="notes-input" rows="2" placeholder="e.g. No onions, well done steak, allergy info..."></textarea>
    <div class="cart-grand-total">
      <span>Total</span>
      <span id="cartGrandTotal">£0.00</span>
    </div>
    <button class="place-order-btn" onclick="placeOrder()">Place Order 🍺</button>
    <button class="close-cart-btn" onclick="closeCart()">Continue browsing</button>
  </div>
</div>

<!-- Confirmation screen -->
<div class="confirm-screen" id="confirmScreen">
  <div class="confirm-icon">🍻</div>
  <div class="confirm-title">Order Placed!</div>
  <div class="confirm-sub">Your order is on its way to the bar and kitchen. No need to queue — we'll bring everything to Table 7.</div>
  <div class="confirm-ref">REF: MRD-<span id="confirmRef"></span></div>
  <div class="confirm-sub" style="font-size:13px;margin-bottom:16px">Cheers! Typical wait: 10–15 mins for food, drinks shortly.</div>
  <div class="confirm-back" onclick="resetOrder()">Order something else?</div>
</div>

<script>
const items = {
  1: { name: 'Full English Breakfast', price: 10.50 },
  2: { name: 'Veggie Breakfast', price: 9.50 },
  3: { name: 'Smashed Avo on Toast', price: 8.00 },
  4: { name: 'Bacon or Sausage Bap', price: 5.50 },
  5: { name: 'The Murderers Burger', price: 13.50 },
  6: { name: 'Fish & Chips', price: 14.50 },
  7: { name: "Norfolk Ploughman's", price: 11.50 },
  8: { name: 'Mushroom & Brie Wellington', price: 12.50 },
  9: { name: 'Skin-on Fries', price: 3.50 },
  10: { name: 'Onion Rings', price: 4.00 },
  11: { name: "Woodforde's Wherry", price: 4.80 },
  12: { name: 'London Pride', price: 4.90 },
  13: { name: 'Doom Bar', price: 4.90 },
  14: { name: 'Guest Ale', price: 4.80 },
  15: { name: 'Guinness', price: 5.20 },
  16: { name: 'Peroni Nastro Azzurro', price: 5.50 },
  17: { name: 'Soft Drinks', price: 2.80 }
};

let cart = {};

function renderCtrl(id) {
  const el = document.getElementById('ctrl-' + id);
  const qty = cart[id] || 0;
  if (qty === 0) {
    el.innerHTML = `<button class="add-btn" onclick="add(${id})">+</button>`;
  } else {
    el.innerHTML = `<div class="qty-ctrl">
      <button class="qty-btn" onclick="remove(${id})">−</button>
      <span class="qty-num">${qty}</span>
      <button class="qty-btn" onclick="add(${id})">+</button>
    </div>`;
  }
}

function add(id) {
  cart[id] = (cart[id] || 0) + 1;
  renderCtrl(id);
  updateCartBar();
}

function remove(id) {
  if (cart[id] > 0) cart[id]--;
  if (cart[id] === 0) delete cart[id];
  renderCtrl(id);
  updateCartBar();
}

function updateCartBar() {
  const count = Object.values(cart).reduce((a, b) => a + b, 0);
  const total = Object.entries(cart).reduce((sum, [id, qty]) => sum + items[id].price * qty, 0);
  document.getElementById('cartCount').textContent = count;
  document.getElementById('cartTotal').textContent = '£' + total.toFixed(2);
  const bar = document.getElementById('cartBar');
  if (count > 0) bar.classList.add('visible');
  else bar.classList.remove('visible');
}

function openCart() {
  const container = document.getElementById('cartItems');
  const total = Object.entries(cart).reduce((sum, [id, qty]) => sum + items[id].price * qty, 0);
  let html = '';
  for (const [id, qty] of Object.entries(cart)) {
    const item = items[id];
    html += `<div class="cart-item">
      <div>
        <div class="cart-item-name">${item.name}</div>
        <div class="cart-item-sub">x${qty} · £${(item.price * qty).toFixed(2)}</div>
      </div>
      <div style="display:flex;align-items:center;gap:12px">
        <div class="cart-item-price">£${(item.price * qty).toFixed(2)}</div>
        <span class="cart-remove" onclick="removeFromCart(${id})">×</span>
      </div>
    </div>`;
  }
  container.innerHTML = html;
  document.getElementById('cartGrandTotal').textContent = '£' + total.toFixed(2);
  document.getElementById('cartOverlay').classList.add('open');
}

function removeFromCart(id) {
  delete cart[id];
  renderCtrl(id);
  updateCartBar();
  if (Object.keys(cart).length === 0) closeCart();
  else openCart();
}

function closeCart() {
  document.getElementById('cartOverlay').classList.remove('open');
}

function placeOrder() {
  const ref = Math.floor(1000 + Math.random() * 9000);
  document.getElementById('confirmRef').textContent = ref;
  document.getElementById('cartOverlay').classList.remove('open');
  document.getElementById('confirmScreen').classList.add('open');
}

function resetOrder() {
  cart = {};
  Object.keys(items).forEach(id => renderCtrl(id));
  updateCartBar();
  document.getElementById('confirmScreen').classList.remove('open');
}

function scrollTo(id) {
  document.getElementById(id).scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.querySelectorAll('.cat-tab').forEach(t => t.classList.remove('active'));
  event.target.classList.add('active');
}

// Init all controls
Object.keys(items).forEach(id => renderCtrl(parseInt(id)));
</script>
</body>
</html>
