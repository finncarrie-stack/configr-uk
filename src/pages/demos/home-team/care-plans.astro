    access: "Key safe code 2390 (left of front door). Hard of hearing — knock loudly and announce yourself. Hoist in bedroom — check training record before first visit."
  },
  {
    id: 4,
    user: "Colin Farrow", age: 75,
    address: "22 Plumstead Road, Norwich NR1 4JT",
    controcc: "", funding: "Private Pay",
    status: "Active", reviewStatus: "ok",
    planStart: "2 Feb 2024", nextReview: "2 Aug 2026",
    commissioned: 7, conditions: "Post-stroke rehabilitation, limited right-side mobility",
    carers: ["Tom H."], leadCarer: "Tom H.",
    visits: [
      { label: "Morning Visit (MWF)", days: "Mon / Wed / Fri", time: "9:00 AM", duration: "60 min",
        tasks: [
          { name: "Personal care", note: "Assist right side only — encourage independence on left." },
          { name: "Mobility exercises", note: "Refer to blue physio folder in kitchen. 10 min exercises." },
          { name: "Breakfast assistance", note: "" }
        ]},
      { label: "Morning Visit (T/Th)", days: "Tue / Thu", time: "9:00 AM", duration: "45 min",
        tasks: [
          { name: "Personal care", note: "" },
          { name: "Medication prompt", note: "Aspirin 75mg, Atorvastatin 20mg — prompt only." }
        ]}
    ],
    medications: [
      { name: "Aspirin 75mg", time: "Morning (with food)", route: "Oral", prompt: true, administer: false },
      { name: "Atorvastatin 20mg", time: "Morning", route: "Oral", prompt: true, administer: false },
      { name: "Ramipril 5mg", time: "Morning", route: "Oral", prompt: true, administer: false },
    ],
    risks: ["Limited right-side mobility — trip hazard","Post-stroke fatigue — do not overexert during exercises"],
    riskLevels: ["amber","amber"],
    keyNotes: "Private pay client — invoice to Patricia Farrow (wife, lives at address) on 1st of each month. Physio exercises are critical — ensure they are completed and logged. Colin is motivated and cooperative.",
    access: "Ring doorbell. Wife Patricia usually home. No key safe currently."
  },
  {
    id: 5,
    user: "Gladys Norton", age: 85,
    address: "3 Hawthorn Drive, Hellesdon, Norwich NR6 5PR",
    controcc: "NCC-2026-014502", funding: "Norfolk CC",
    status: "Draft", reviewStatus: "new",
    planStart: "TBC", nextReview: "TBC",
    commissioned: 10.5, conditions: "Hip replacement recovery, anxiety",
    carers: [], leadCarer: null,
    visits: [
      { label: "Morning Visit", days: "Daily", time: "9:00 AM", duration: "45 min",
        tasks: [
          { name: "Personal care", note: "Post hip surgery — follow physio guidance. Do not rush." },
          { name: "Medication prompt", note: "Paracetamol 1g if in pain — confirm with family before first visit." },
          { name: "Breakfast preparation", note: "" }
        ]},
      { label: "Lunchtime Visit", days: "Mon / Wed / Fri", time: "1:00 PM", duration: "30 min",
        tasks: [
          { name: "Lunch preparation", note: "" },
          { name: "Welfare check", note: "Check pain levels. Log any concerns." }
        ]}
    ],
    medications: [
      { name: "Paracetamol 1g (PRN)", time: "As required — max 4/day", route: "Oral", prompt: true, administer: false },
      { name: "Enoxaparin (injection)", time: "Daily — GP to confirm if still required", route: "Injection", prompt: false, administer: false },
    ],
    risks: ["Post hip surgery — falls risk","Anxiety — may be distressed by new carers"],
    riskLevels: ["red","amber"],
    keyNotes: "New referral from Norfolk CC — plan not yet finalised. First visit target w/c 9 Jun. Key safe to be installed before first visit (daughter Sandra arranging). Introduce the same carer for first 3 visits to reduce anxiety.",
    access: "TBC — key safe being arranged. Contact daughter Sandra on 07445 221100 before first visit."
  }
];

function initials(name){ return name ? name.split(' ').map(w=>w[0]).join('') : '?'; }

function fundingPill(f){
  const map = {"Norfolk CC":"pill-cc","Private Pay":"pill-private","Mixed":"pill-mixed"};
  return `<span class="pill ${map[f]||''}">${f}</span>`;
}

function renderCards(){
  const container = document.getElementById('plansGrid');
  container.innerHTML = plans.map(p => {
    const headCls = p.reviewStatus === 'review' ? 'review' : p.reviewStatus === 'new' ? 'new' : '';
    const statusLabel = p.reviewStatus === 'review' ? '⚠️ Review Due' : p.reviewStatus === 'new' ? '🆕 Draft' : '✓ Active';
    const carerAvatars = p.carers.length
      ? `<div style="display:flex;gap:-4px">${p.carers.slice(0,3).map((c,i)=>`<div style="width:24px;height:24px;border-radius:50%;background:${CARER_COLORS[c]||'#999'};border:2px solid #fff;margin-left:${i?-6:0}px;display:inline-flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#fff">${initials(c)}</div>`).join('')}</div>`
      : `<span style="font-size:12px;color:var(--coral);font-weight:600">No carers assigned</span>`;

    return `<div class="plan-card" onclick="openDrawer(${p.id})">
      <div class="plan-card-head ${headCls}">
        <div>
          <div class="plan-name">${p.user}</div>
          <div class="plan-meta">Age ${p.age} · ${p.conditions.split(',')[0]}</div>
        </div>
        <div class="plan-status-chip">${statusLabel}</div>
      </div>
      <div class="plan-body">
        <div class="plan-row"><span class="lbl">Controcc Ref</span><span class="val" style="font-family:monospace;font-size:12px">${p.controcc || '—'}</span></div>
        <div class="plan-row"><span class="lbl">Funding</span><span class="val">${fundingPill(p.funding)}</span></div>
        <div class="plan-row"><span class="lbl">Commissioned</span><span class="val">${p.commissioned}h/wk · ${p.visits.length} visit${p.visits.length!==1?'s':''}/day</span></div>
        <div class="plan-row"><span class="lbl">Next Review</span><span class="val" style="${p.reviewStatus==='review'?'color:var(--amber)':''}">${p.nextReview}</span></div>
        <div class="plan-row"><span class="lbl">Assigned Carers</span><span class="val">${carerAvatars}</span></div>
      </div>
      <div class="plan-footer">
        <button class="btn btn-outline" style="flex:1;font-size:12px" onclick="event.stopPropagation();openDrawer(${p.id})">View Plan</button>
        <button class="btn btn-lime" style="font-size:12px" onclick="event.stopPropagation()">⬇ PDF</button>
        <button class="btn btn-outline" style="font-size:12px" onclick="event.stopPropagation()">📨 Send</button>
      </div>
    </div>`;
  }).join('');
}

function openDrawer(id){
  const p = plans.find(x=>x.id===id);
  const d = document.getElementById('drawer');

  const carerChips = p.carers.length
    ? p.carers.map(c=>`<div class="carer-chip"><div class="carer-av-sm" style="background:${CARER_COLORS[c]||'#999'}">${initials(c)}</div>${c}${c===p.leadCarer?'<span class="lead-tag">Lead</span>':''}</div>`).join('')
    : `<div style="color:var(--coral);font-size:13px;font-weight:600">⚠️ No carers assigned — assign before plan goes live.</div>`;

  const medRows = p.medications.map(m=>`<tr>
    <td><strong>${m.name}</strong></td>
    <td>${m.time}</td>
    <td>${m.route}</td>
    <td style="text-align:center">${m.prompt?'<span style="color:var(--lime);font-weight:700">✓</span>':'—'}</td>
    <td style="text-align:center">${m.administer?'<span style="color:var(--coral);font-weight:700">✓ Authorised</span>':'—'}</td>
  </tr>`).join('');

  const riskTags = p.risks.map((r,i)=>`<span class="risk-tag ${p.riskLevels[i]==='red'?'':p.riskLevels[i]==='low'?'low':'amber'}">${r}</span>`).join('');

  d.innerHTML = `
    <div class="drawer-head">
      <div class="drawer-head-inner">
        <div class="title">Care Plan — ${p.user}</div>
        <div class="sub">Last updated: 1 Jun 2026 · ${p.status}</div>
      </div>
      <div style="display:flex;gap:8px;align-items:center">
        <button class="btn btn-lime" style="font-size:12px">⬇ PDF for Carers</button>
        <button class="drawer-close" onclick="closeDrawer()">×</button>
      </div>
    </div>
    <div class="drawer-body">
      <div class="drawer-tabs">
        <div class="drawer-tab active" onclick="showTab('overview',this)">Overview</div>
        <div class="drawer-tab" onclick="showTab('visits',this)">Visit Schedule & Tasks</div>
        <div class="drawer-tab" onclick="showTab('medication',this)">Medication</div>
        <div class="drawer-tab" onclick="showTab('risks',this)">Risks & Notes</div>
        <div class="drawer-tab" onclick="showTab('carers',this)">Carers</div>
      </div>

      <div class="drawer-section active" id="tab-overview">
        <div class="info-grid">
          <div class="info-card"><div class="k">Service User</div><div class="v">${p.user}, age ${p.age}</div></div>
          <div class="info-card"><div class="k">Funding</div><div class="v">${fundingPill(p.funding)}</div></div>
          <div class="info-card"><div class="k">Controcc Ref</div><div class="v" style="font-family:monospace;font-size:12px">${p.controcc||'N/A — Private'}</div></div>
          <div class="info-card"><div class="k">Commissioned Hours</div><div class="v">${p.commissioned}h / week</div></div>
          <div class="info-card"><div class="k">Plan Started</div><div class="v">${p.planStart}</div></div>
          <div class="info-card"><div class="k">Next Review</div><div class="v" style="${p.reviewStatus==='review'?'color:var(--amber);':''}">${p.nextReview}</div></div>
          <div class="info-card full"><div class="k">Address</div><div class="v">${p.address}</div></div>
          <div class="info-card full"><div class="k">Access Instructions</div><div class="v">${p.access}</div></div>
          <div class="info-card full"><div class="k">Conditions</div><div class="v">${p.conditions}</div></div>
        </div>
        <div class="section-title">Risk Summary</div>
        <div style="margin-bottom:16px">${riskTags}</div>
        <div class="section-title">Assigned Carers</div>
        <div class="carer-strip">${carerChips}</div>
      </div>

      <div class="drawer-section" id="tab-visits">
        <div class="visit-blocks">
          ${p.visits.map(v=>`
            <div class="visit-block">
              <div class="visit-block-head">
                <div><div class="vtitle">${v.label}</div><div class="vmeta">${v.days} · ${v.time} · ${v.duration}</div></div>
                <span style="font-size:12px;color:var(--olive);font-weight:600">${v.tasks.length} tasks</span>
              </div>
              <div class="visit-block-body">
                ${v.tasks.map(t=>`<div class="task-item">
                  <div class="task-check">✓</div>
                  <div class="task-detail">
                    <div class="task-name">${t.name}</div>
                    ${t.note?`<div class="task-note">${t.note}</div>`:''}
                  </div>
                </div>`).join('')}
              </div>
            </div>`).join('')}
        </div>
      </div>

      <div class="drawer-section" id="tab-medication">
        <div class="note-box">⚠️ Only administer medication where explicitly authorised below. For prompt-only medications, remind the service user and record compliance in the visit log. Never administer without authorisation.</div>
        <table class="med-table">
          <thead><tr><th>Medication</th><th>Time</th><th>Route</th><th style="text-align:center">Prompt Only</th><th style="text-align:center">Administer</th></tr></thead>
          <tbody>${medRows}</tbody>
        </table>
      </div>

      <div class="drawer-section" id="tab-risks">
        <div class="section-title">Identified Risks</div>
        <div style="margin-bottom:16px">${riskTags}</div>
        <div class="section-title">Key Notes for Carers</div>
        <div class="note-box">${p.keyNotes}</div>
        <div class="section-title">Access Instructions</div>
        <div style="background:var(--bg);border-radius:9px;padding:12px 14px;font-size:13px;margin-bottom:16px">${p.access}</div>
      </div>

      <div class="drawer-section" id="tab-carers">
        <div class="section-title">Assigned Care Team</div>
        <div class="carer-strip" style="flex-direction:column;gap:10px">${p.carers.length
          ? p.carers.map(c=>`<div class="carer-chip" style="border-radius:10px;padding:10px 14px">
              <div class="carer-av-sm" style="background:${CARER_COLORS[c]||'#999'};width:34px;height:34px;font-size:12px">${initials(c)}</div>
              <div><div style="font-weight:700">${c}</div><div style="font-size:12px;color:var(--muted)">Care Worker${c===p.leadCarer?' · Lead Carer':''}</div></div>
              ${c===p.leadCarer?'<span class="lead-tag" style="margin-left:auto">Lead</span>':''}
            </div>`).join('')
          : '<div style="color:var(--coral);font-weight:600;font-size:13px">No carers assigned yet.</div>'
        }</div>
        <div style="margin-top:16px;display:flex;gap:10px">
          <button class="btn btn-primary" style="flex:1">+ Assign Carer</button>
          <button class="btn btn-outline">📨 Send Plan to All Carers</button>
        </div>
      </div>
    </div>`;

  document.querySelectorAll('.drawer-section').forEach((s,i)=>s.classList.toggle('active',i===0));
  document.querySelectorAll('.drawer-tab').forEach((t,i)=>t.classList.toggle('active',i===0));
  document.getElementById('overlay').classList.add('open');
  d.classList.add('open');
}

function closeDrawer(){
  document.getElementById('overlay').classList.remove('open');
  document.getElementById('drawer').classList.remove('open');
}

function showTab(name, el){
  document.querySelectorAll('.drawer-tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.drawer-section').forEach(s=>s.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-'+name).classList.add('active');
}

renderCards();
</script>
</body>
</html>
