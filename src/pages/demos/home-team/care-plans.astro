<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Home Team — Care Plans</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --olive:      #4a5e25;
    --olive-mid:  #5c7530;
    --lime:       #8ab540;
    --lime-light: #f0f7e0;
    --coral:      #d4614a;
    --coral-light:#fdf0ee;
    --bg:         #f4f7f0;
    --white:      #ffffff;
    --border:     #dde8cf;
    --text:       #1e2d10;
    --muted:      #6b7c4a;
    --amber:      #d4900a;
    --amber-light:#fef8e8;
    --blue:       #2563eb;
    --blue-light: #eff6ff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; }

  .topbar { background: var(--olive); padding: 0 28px; display: flex; align-items: center; justify-content: space-between; height: 58px; position: sticky; top: 0; z-index: 50; }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-logo { width: 36px; height: 36px; background: rgba(255,255,255,0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .brand-name { color: #fff; font-size: 16px; font-weight: 700; }
  .brand-name span { color: rgba(255,255,255,0.6); font-weight: 400; font-size: 13px; display: block; }
  .topbar-nav { display: flex; gap: 2px; }
  .nav-item { color: rgba(255,255,255,0.65); font-size: 13px; font-weight: 500; padding: 8px 14px; border-radius: 8px; cursor: pointer; transition: all 0.15s; text-decoration: none; display: inline-block; }
  .nav-item:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .nav-item.active { background: rgba(255,255,255,0.18); color: #fff; font-weight: 600; }
  .topbar-right { display: flex; align-items: center; gap: 10px; }
  .demo-pill { background: var(--coral); color: #fff; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 20px; }
  .avatar { width: 30px; height: 30px; background: var(--lime); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; color: #fff; }
  .user-chip { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.8); font-size: 13px; }

  .page { display: flex; height: calc(100vh - 58px); }

  .sidebar { width: 220px; background: var(--white); border-right: 1px solid var(--border); padding: 16px 12px; flex-shrink: 0; overflow-y: auto; }
  .sidebar-section { margin-bottom: 24px; }
  .sidebar-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 0 8px; margin-bottom: 6px; }
  .sidebar-item { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px; font-size: 13px; font-weight: 500; color: var(--muted); cursor: pointer; transition: all 0.15s; }
  .sidebar-item:hover { background: var(--bg); color: var(--text); }
  .sidebar-item.active { background: var(--lime-light); color: var(--olive); font-weight: 600; }
  .sidebar-item .icon { font-size: 15px; width: 20px; text-align: center; }
  .sidebar-badge { margin-left: auto; background: var(--coral); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; }
  .sidebar-badge.amber { background: var(--amber); }

  .main { flex: 1; overflow-y: auto; padding: 24px 28px 80px; }

  .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .page-title { font-size: 22px; font-weight: 800; }
  .page-sub { font-size: 13px; color: var(--muted); margin-top: 2px; }
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px; border-radius: 9px; font-size: 13px; font-weight: 600; border: none; cursor: pointer; transition: all 0.15s; font-family: inherit; }
  .btn-primary { background: var(--coral); color: #fff; }
  .btn-primary:hover { background: #c0553f; }
  .btn-outline { background: #fff; color: var(--olive); border: 1.5px solid var(--border); }
  .btn-outline:hover { border-color: var(--olive); }
  .btn-lime { background: var(--lime); color: #fff; }
  .btn-lime:hover { background: #7aa030; }

  .filters { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; align-items: center; }
  .filter-input { font-family: inherit; font-size: 13px; padding: 8px 12px; border: 1.5px solid var(--border); border-radius: 9px; background: var(--white); color: var(--text); min-width: 220px; }
  .filter-input:focus { outline: none; border-color: var(--olive); }
  .filter-select { font-family: inherit; font-size: 13px; padding: 8px 12px; border: 1.5px solid var(--border); border-radius: 9px; background: var(--white); color: var(--text); }

  /* Plan cards grid */
  .plans-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }

  .plan-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.12s, box-shadow 0.15s, border-color 0.15s;
  }
  .plan-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(74,94,37,0.12); border-color: #b8d890; }
  .plan-card-head {
    background: var(--olive);
    padding: 16px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .plan-card-head.review { background: var(--amber); }
  .plan-card-head.new { background: var(--blue); }
  .plan-name { color: #fff; font-weight: 700; font-size: 15px; }
  .plan-meta { color: rgba(255,255,255,0.75); font-size: 12px; margin-top: 2px; }
  .plan-status-chip { background: rgba(255,255,255,0.2); color: #fff; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 20px; white-space: nowrap; }
  .plan-body { padding: 14px 18px; }
  .plan-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f0f4ea; font-size: 13px; }
  .plan-row:last-child { border-bottom: none; }
  .plan-row .lbl { color: var(--muted); font-size: 12px; }
  .plan-row .val { font-weight: 600; }
  .plan-footer { padding: 12px 18px; background: #f8faf4; border-top: 1px solid var(--border); display: flex; gap: 8px; }

  .pill { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap; }
  .pill-active { background: #e8f5d8; color: #3a6e10; border: 1px solid #c0e090; }
  .pill-review { background: var(--amber-light); color: #8a5a00; border: 1px solid #f0d080; }
  .pill-new { background: var(--blue-light); color: #1a4db8; border: 1px solid #bfdbfe; }
  .pill-cc { background: var(--lime-light); color: var(--olive); border: 1px solid #c8e090; }
  .pill-private { background: #f3f0ff; color: #5b21b6; border: 1px solid #ddd6fe; }
  .pill-mixed { background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; }

  /* Hours ring */
  .hours-ring-wrap { display: flex; align-items: center; gap: 14px; padding: 12px 0; }
  .ring-svg { flex-shrink: 0; }
  .ring-label { font-size: 12px; color: var(--muted); line-height: 1.6; }
  .ring-label strong { color: var(--text); font-size: 14px; }

  /* Visit blocks */
  .visit-blocks { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .visit-block { border: 1.5px solid var(--border); border-radius: 10px; overflow: hidden; }
  .visit-block-head { background: var(--lime-light); padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; }
  .visit-block-head .vtitle { font-weight: 700; font-size: 13px; color: var(--olive); }
  .visit-block-head .vmeta { font-size: 12px; color: var(--muted); }
  .visit-block-body { padding: 12px 14px; background: var(--white); }
  .task-item { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; padding: 5px 0; border-bottom: 1px solid #f0f4ea; }
  .task-item:last-child { border-bottom: none; }
  .task-check { width: 20px; height: 20px; border-radius: 5px; background: var(--lime-light); border: 1.5px solid var(--lime); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--olive); flex-shrink: 0; margin-top: 1px; }
  .task-detail { flex: 1; }
  .task-name { font-weight: 600; }
  .task-note { font-size: 12px; color: var(--muted); }

  /* Meds table */
  .med-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
  .med-table th { text-align: left; padding: 7px 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); border-bottom: 1px solid var(--border); background: #f8faf4; }
  .med-table td { padding: 9px 12px; border-bottom: 1px solid #f0f4ea; }
  .med-table tr:last-child td { border-bottom: none; }

  /* Carer assign strip */
  .carer-strip { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .carer-chip { display: flex; align-items: center; gap: 8px; background: var(--bg); border: 1.5px solid var(--border); border-radius: 20px; padding: 6px 12px 6px 6px; font-size: 13px; font-weight: 600; }
  .carer-av-sm { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: #fff; }
  .lead-tag { font-size: 10px; font-weight: 700; background: var(--lime-light); color: var(--olive); padding: 2px 6px; border-radius: 4px; }

  /* Print styles */
  .print-header { display: none; }
  @media print {
    .topbar, .sidebar, .filters, .plans-grid, .plan-footer, .btn, .demo-pill, .configr-bar { display: none !important; }
    .overlay, .drawer { position: relative !important; transform: none !important; width: 100% !important; box-shadow: none !important; }
    .print-header { display: block !important; }
    .page { display: block; height: auto; }
    .main { display: none; }
  }

  /* Drawer */
  .overlay { position: fixed; inset: 0; background: rgba(30,45,16,0.4); z-index: 100; display: none; }
  .overlay.open { display: block; }
  .drawer { position: fixed; top: 0; right: 0; height: 100%; width: 580px; max-width: 96vw; background: var(--white); z-index: 110; transform: translateX(100%); transition: transform 0.25s cubic-bezier(0.4,0,0.2,1); overflow-y: auto; box-shadow: -6px 0 24px rgba(0,0,0,0.12); }
  .drawer.open { transform: translateX(0); }
  .drawer-head { padding: 20px 24px; border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--white); z-index: 2; display: flex; justify-content: space-between; align-items: flex-start; }
  .drawer-head-inner .title { font-size: 18px; font-weight: 800; color: var(--text); }
  .drawer-head-inner .sub { font-size: 13px; color: var(--muted); margin-top: 2px; }
  .drawer-close { background: var(--bg); border: none; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 18px; color: var(--muted); }
  .drawer-body { padding: 22px 24px; }
  .drawer-tabs { display: flex; border-bottom: 2px solid var(--border); margin-bottom: 20px; overflow-x: auto; }
  .drawer-tab { padding: 10px 16px; font-size: 13px; font-weight: 600; color: var(--muted); cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -2px; white-space: nowrap; transition: all 0.15s; }
  .drawer-tab.active { color: var(--olive); border-bottom-color: var(--olive); }
  .drawer-section { display: none; }
  .drawer-section.active { display: block; }
  .section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 10px; }
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 18px; }
  .info-card { background: var(--bg); border-radius: 9px; padding: 11px 13px; }
  .info-card .k { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 3px; }
  .info-card .v { font-size: 13px; font-weight: 600; }
  .info-card.full { grid-column: 1/3; }
  .note-box { background: #fffbf0; border: 1px solid #f0d878; border-radius: 9px; padding: 12px 14px; font-size: 13px; color: #5a4000; margin-bottom: 16px; line-height: 1.6; }
  .risk-tag { display: inline-block; background: var(--coral-light); border: 1px solid #f0b8a8; color: #8a2010; font-size: 11px; font-weight: 700; padding: 3px 9px; border-radius: 6px; margin: 2px; }
  .risk-tag.amber { background: var(--amber-light); border-color: #f0d080; color: #7a5500; }
  .risk-tag.low { background: var(--lime-light); border-color: #c0e090; color: #3a6010; }

  .configr-bar { background: var(--olive); color: rgba(255,255,255,0.7); text-align: center; font-size: 12px; padding: 12px; position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; }
  .configr-bar strong { color: #fff; }
</style>
</head>
