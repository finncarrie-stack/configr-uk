      { type: "green", msg: "Family informed of rota changes 28 May." }
    ]
  },
  {
    id: 4, name: "Colin Farrow", dob: "18 Apr 1951", age: 75,
    address: "22 Plumstead Road, Norwich NR1 4JT",
    nhs: "601 337 8854", controcc: "NCC-2024-012887",
    funding: "Private Pay", status: "Active",
    commissioned: 7, delivered: 7,
    carers: ["Tom H."],
    keyContacts: "Wife: Patricia Farrow 07321 667788 (lives at same address)",
    access: "Ring doorbell. Wife usually home. No key safe.",
    conditions: "Post-stroke rehabilitation, limited right-side mobility",
    careplan: {
      start: "2 Feb 2024", review: "2 Aug 2026",
      visits: [
        { days: "Mon/Wed/Fri", time: "9:00 AM", duration: "60 min", tasks: ["Personal care","Mobility exercises","Breakfast assistance"] },
        { days: "Tue/Thu", time: "9:00 AM", duration: "45 min", tasks: ["Personal care","Medication prompt"] },
      ],
      notes: "Private pay client — invoice monthly to Patricia Farrow. Physio exercises printed and in blue folder in kitchen."
    },
    alerts: [
      { type: "green", msg: "All hours delivered. Invoice sent 1 Jun — payment pending." }
    ]
  },
  {
    id: 5, name: "Gladys Norton", dob: "7 Sep 1940", age: 85,
    address: "3 Hawthorn Drive, Hellesdon, Norwich NR6 5PR",
    nhs: "447 928 0065", controcc: "NCC-2022-009341",
    funding: "Norfolk CC", status: "New Referral",
    commissioned: 10.5, delivered: 0,
    carers: [],
    keyContacts: "Daughter: Sandra Cope 07445 221100",
    access: "TBC — daughter to arrange key safe before first visit.",
    conditions: "Hip replacement recovery, anxiety",
    careplan: {
      start: "TBC — awaiting confirmation", review: "—",
      visits: [
        { days: "Daily", time: "9:00 AM", duration: "45 min", tasks: ["Personal care","Medication prompt","Breakfast"] },
        { days: "Mon/Wed/Fri", time: "1:00 PM", duration: "30 min", tasks: ["Lunch preparation","Welfare check"] },
      ],
      notes: "New referral from Norfolk CC 28 May 2026. Awaiting carer assignment. First visit target: w/c 9 Jun."
    },
    alerts: [
      { type: "amber", msg: "No carers assigned yet. First visit target w/c 9 Jun — assign carer urgently." },
      { type: "amber", msg: "Key safe not yet installed — confirm with Sandra Cope before first visit." }
    ]
  },
];

const carerColors = {"Sarah M.": COLORS[0], "Ben T.": COLORS[1], "Leanne W.": COLORS[2], "Tom H.": COLORS[3], "Claire B.": COLORS[4], "Amy R.": COLORS[5]};

function initials(name){ return name.split(' ').map(w=>w[0]).join(''); }

function hoursBar(delivered, commissioned){
  const pct = Math.min(100, Math.round((delivered/commissioned)*100));
  const cls = pct >= 95 ? '' : pct >= 80 ? 'low' : 'over';
  return `<div class="hours-bar">
    <div class="bar-track"><div class="bar-fill ${cls}" style="width:${pct}%"></div></div>
    <span style="font-size:12px;font-weight:600;color:${pct<80?'var(--coral)':pct<95?'var(--amber)':'var(--olive)'}">${delivered}/${commissioned}h</span>
  </div>`;
}

function carerStack(carers){
  if(!carers.length) return '<span style="font-size:12px;color:var(--coral);font-weight:600">Unassigned</span>';
  return `<div class="carer-stack">${carers.slice(0,3).map((c,i)=>`<div class="carer-av" style="background:${carerColors[c]||COLORS[i]};z-index:${3-i}" title="${c}">${initials(c)}</div>`).join('')}${carers.length>3?`<div class="carer-av" style="background:#999">+${carers.length-3}</div>`:''}</div>`;
}

function statusPill(s){
  const map = {"Active":"pill-active","Suspended":"pill-suspended","New Referral":"pill-new"};
  return `<span class="pill ${map[s]||''}">${s}</span>`;
}

function fundingPill(f){
  const map = {"Norfolk CC":"pill-cc","Private Pay":"pill-private","Mixed":"pill-mixed"};
  return `<span class="pill ${map[f]||''}">${f}</span>`;
}

function renderTable(list){
  document.getElementById('suBody').innerHTML = list.map(u=>`
    <tr class="clickable" onclick="openDrawer(${u.id})">
      <td><strong>${u.name}</strong><div style="font-size:11px;color:var(--muted);margin-top:2px">DOB: ${u.dob}</div></td>
      <td style="font-family:monospace;font-size:12px">${u.controcc}</td>
      <td style="font-size:12px;color:var(--muted);max-width:180px">${u.address}</td>
      <td>${fundingPill(u.funding)}</td>
      <td>${hoursBar(u.delivered, u.commissioned)}</td>
      <td>${carerStack(u.carers)}</td>
      <td>${statusPill(u.status)}</td>
    </tr>`).join('');
}

function filterTable(q){
  const lq = q.toLowerCase();
  renderTable(users.filter(u=> `${u.name} ${u.address} ${u.controcc}`.toLowerCase().includes(lq)));
}
function filterStatus(s){
  renderTable(s ? users.filter(u=>u.status===s) : users);
}

function openDrawer(id){
  const u = users.find(x=>x.id===id);
  document.getElementById('dName').textContent = u.name;
  document.getElementById('dSub').textContent = `${u.address} · ${u.controcc}`;

  // Profile tab
  document.getElementById('tab-profile').innerHTML = `
    <div class="info-grid">
      <div class="info-card"><div class="k">Date of Birth</div><div class="v">${u.dob} (age ${u.age})</div></div>
      <div class="info-card"><div class="k">NHS Number</div><div class="v" style="font-family:monospace">${u.nhs}</div></div>
      <div class="info-card"><div class="k">Controcc Reference</div><div class="v" style="font-family:monospace">${u.controcc}</div></div>
      <div class="info-card"><div class="k">Funding Type</div><div class="v">${fundingPill(u.funding)}</div></div>
      <div class="info-card full"><div class="k">Address</div><div class="v">${u.address}</div></div>
      <div class="info-card full"><div class="k">Key Contact</div><div class="v">${u.keyContacts}</div></div>
      <div class="info-card full"><div class="k">Access Notes</div><div class="v">${u.access}</div></div>
      <div class="info-card full"><div class="k">Conditions / Background</div><div class="v">${u.conditions}</div></div>
    </div>
    <div class="section-title">Hours This Month</div>
    <div style="background:var(--bg);border-radius:10px;padding:14px 16px;margin-bottom:20px;">
      ${hoursBar(u.delivered, u.commissioned)}
      <div style="font-size:12px;color:var(--muted);margin-top:8px">Commissioned: <strong>${u.commissioned}h/wk</strong> · Delivered: <strong>${u.delivered}h/wk</strong></div>
    </div>
    <div style="display:flex;gap:10px">
      <button class="btn btn-primary" style="flex:1">View Visit Log</button>
      <button class="btn btn-outline" style="flex:1">Edit Profile</button>
    </div>`;

  // Care plan tab
  const cp = u.careplan;
  document.getElementById('tab-careplan').innerHTML = `
    <div class="info-grid" style="margin-bottom:16px">
      <div class="info-card"><div class="k">Plan Start</div><div class="v">${cp.start}</div></div>
      <div class="info-card"><div class="k">Next Review</div><div class="v">${cp.review}</div></div>
    </div>
    <div class="section-title">Visit Schedule</div>
    <div class="visit-schedule">
      ${cp.visits.map(v=>`
        <div class="visit-row">
          <div class="visit-day">${v.days}</div>
          <div class="visit-time">${v.time}</div>
          <div class="visit-duration">${v.duration}</div>
        </div>
        <div class="task-list" style="padding:4px 0 8px 14px">
          ${v.tasks.map(t=>`<div class="task-item"><div class="task-check">✓</div>${t}</div>`).join('')}
        </div>`).join('')}
    </div>
    <div class="section-title">Care Plan Notes</div>
    <div style="background:var(--bg);border-radius:10px;padding:12px 14px;font-size:13px;color:var(--text);margin-bottom:16px">${cp.notes}</div>
    <button class="btn btn-outline" style="width:100%">⬇ Download Care Plan PDF</button>`;

  // Carers tab
  document.getElementById('tab-carers').innerHTML = u.carers.length ? `
    <div class="carer-cards">
      ${u.carers.map((c,i)=>`
        <div class="carer-card">
          <div class="carer-avatar-lg" style="background:${carerColors[c]||COLORS[i]}">${initials(c)}</div>
          <div class="carer-info"><div class="name">${c}</div><div class="role">Care Worker</div></div>
          ${i===0?'<div class="carer-lead">Lead Carer</div>':''}
        </div>`).join('')}
    </div>
    <button class="btn btn-outline" style="width:100%">+ Assign Carer</button>` :
    `<div style="text-align:center;padding:32px 0;color:var(--muted)">
      <div style="font-size:32px;margin-bottom:12px">👤</div>
      <div style="font-weight:700;margin-bottom:6px">No carers assigned</div>
      <div style="font-size:13px;margin-bottom:16px">This service user needs carers assigned before visits can begin.</div>
      <button class="btn btn-primary">+ Assign Carer</button>
    </div>`;

  // Alerts tab
  document.getElementById('tab-alerts').innerHTML = `
    ${u.alerts.map(a=>`<div class="alert-card ${a.type}"><div>${a.type==='red'?'🔴':a.type==='amber'?'⚠️':'✅'}</div><div>${a.msg}</div></div>`).join('')}`;

  // Reset tabs
  document.querySelectorAll('.drawer-tab').forEach((t,i)=>{ t.classList.toggle('active', i===0); });
  document.querySelectorAll('.drawer-section').forEach((s,i)=>{ s.classList.toggle('active', i===0); });

  document.getElementById('overlay').classList.add('open');
  document.getElementById('drawer').classList.add('open');
}

function closeDrawer(){
  document.getElementById('overlay').classList.remove('open');
  document.getElementById('drawer').classList.remove('open');
}

function showTab(name, el){
  document.querySelectorAll('.drawer-tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.drawer-section').forEach(s=>s.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-'+name).classList.add('active');
}

renderTable(users);
</script>
</body>
</html>
