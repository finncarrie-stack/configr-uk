  </div>

  <!-- Main -->
  <div class="main" style="padding-bottom: 60px;">

    <div class="page-header">
      <div>
        <div class="page-title">Service Users</div>
        <div class="page-sub">24 active · 2 new referrals · June 2026</div>
      </div>
      <div style="display:flex;gap:10px">
        <button class="btn btn-outline">⬇ Export</button>
        <button class="btn btn-primary">+ Add Service User</button>
      </div>
    </div>

    <div class="stats">
      <div class="stat olive"><div class="n">24</div><div class="l">Active Users</div></div>
      <div class="stat lime"><div class="n">187.5h</div><div class="l">Hours This Week</div></div>
      <div class="stat amber"><div class="n">3</div><div class="l">Alerts</div></div>
      <div class="stat coral"><div class="n">2</div><div class="l">New Referrals</div></div>
    </div>

    <div class="alert-row">⚠️ <strong>3 service users</strong> have delivered hours below their commissioned package this week — review before month-end Controcc submission.</div>

    <div class="filters">
      <input class="filter-input" placeholder="🔍  Search name, address, Controcc ref…" oninput="filterTable(this.value)">
      <select class="filter-select" onchange="filterStatus(this.value)">
        <option value="">All statuses</option>
        <option>Active</option>
        <option>Suspended</option>
        <option>New Referral</option>
      </select>
      <select class="filter-select">
        <option value="">All funding types</option>
        <option>Norfolk CC</option>
        <option>Private Pay</option>
        <option>Mixed</option>
      </select>
    </div>

    <div class="table-wrap">
      <table id="suTable">
        <thead>
          <tr>
            <th>Name</th>
            <th>Controcc Ref</th>
            <th>Address</th>
            <th>Funding</th>
            <th>Hours/wk</th>
            <th>Carers</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="suBody"></tbody>
      </table>
    </div>

  </div>
</div>

<!-- Overlay + Drawer -->
<div class="overlay" id="overlay" onclick="closeDrawer()"></div>
<div class="drawer" id="drawer">
  <div class="drawer-head">
    <div>
      <div class="drawer-head-name" id="dName"></div>
      <div class="drawer-head-sub" id="dSub"></div>
    </div>
    <button class="drawer-close" onclick="closeDrawer()">×</button>
  </div>
  <div class="drawer-body">
    <div class="drawer-tabs">
      <div class="drawer-tab active" onclick="showTab('profile',this)">Profile</div>
      <div class="drawer-tab" onclick="showTab('careplan',this)">Care Plan</div>
      <div class="drawer-tab" onclick="showTab('carers',this)">Carers</div>
      <div class="drawer-tab" onclick="showTab('alerts',this)">Alerts</div>
    </div>
    <div class="drawer-section active" id="tab-profile"></div>
    <div class="drawer-section" id="tab-careplan"></div>
    <div class="drawer-section" id="tab-carers"></div>
    <div class="drawer-section" id="tab-alerts"></div>
  </div>
</div>

