<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Home Team — Service Users</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --olive:     #4a5e25;
    --olive-mid: #5c7530;
    --lime:      #8ab540;
    --lime-light:#f0f7e0;
    --coral:     #d4614a;
    --coral-light:#fdf0ee;
    --bg:        #f4f7f0;
    --white:     #ffffff;
    --border:    #dde8cf;
    --text:      #1e2d10;
    --muted:     #6b7c4a;
    --amber:     #d4900a;
    --amber-light:#fef8e8;
    --blue:      #2563eb;
    --blue-light:#eff6ff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; }

  /* Top bar */
  .topbar {
    background: var(--olive);
    padding: 0 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-logo {
    width: 36px; height: 36px;
    background: rgba(255,255,255,0.15);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
  }
  .brand-name { color: #fff; font-size: 16px; font-weight: 700; }
  .brand-name span { color: rgba(255,255,255,0.6); font-weight: 400; font-size: 13px; display: block; }
  .topbar-nav { display: flex; gap: 2px; }
  .nav-item {
    color: rgba(255,255,255,0.65);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    display: inline-block;
  }
  .nav-item:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .nav-item.active { background: rgba(255,255,255,0.18); color: #fff; font-weight: 600; }
  .topbar-right { display: flex; align-items: center; gap: 10px; }
  .demo-pill { background: var(--coral); color: #fff; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 20px; }
  .user-chip { display: flex; align-items: center; gap: 8px; color: rgba(255,255,255,0.8); font-size: 13px; }
  .avatar { width: 30px; height: 30px; background: var(--lime); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 12px; color: #fff; }

  /* Page */
  .page { display: flex; height: calc(100vh - 58px); }

  /* Sidebar */
  .sidebar {
    width: 220px;
    background: var(--white);
    border-right: 1px solid var(--border);
    padding: 16px 12px;
    flex-shrink: 0;
    overflow-y: auto;
  }
  .sidebar-section { margin-bottom: 24px; }
  .sidebar-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 0 8px; margin-bottom: 6px; }
  .sidebar-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .sidebar-item:hover { background: var(--bg); color: var(--text); }
  .sidebar-item.active { background: var(--lime-light); color: var(--olive); font-weight: 600; }
  .sidebar-item .icon { font-size: 15px; width: 20px; text-align: center; }
  .sidebar-badge { margin-left: auto; background: var(--coral); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 10px; }
  .sidebar-badge.green { background: var(--lime); }
  .sidebar-badge.amber { background: var(--amber); }

  /* Main content */
  .main { flex: 1; overflow-y: auto; padding: 24px 28px; }

  /* Page header */
  .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .page-title { font-size: 22px; font-weight: 800; color: var(--text); }
  .page-sub { font-size: 13px; color: var(--muted); margin-top: 2px; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 16px; border-radius: 9px;
    font-size: 13px; font-weight: 600;
    border: none; cursor: pointer; transition: all 0.15s;
  }
  .btn-primary { background: var(--coral); color: #fff; }
  .btn-primary:hover { background: #c0553f; }
  .btn-outline { background: #fff; color: var(--olive); border: 1.5px solid var(--border); }
  .btn-outline:hover { border-color: var(--olive); }

  /* Stats row */
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
  .stat {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 18px;
  }
  .stat .n { font-size: 26px; font-weight: 800; line-height: 1; }
  .stat .l { font-size: 11px; color: var(--muted); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }
  .stat.coral .n { color: var(--coral); }
  .stat.lime .n { color: var(--lime); }
  .stat.amber .n { color: var(--amber); }
  .stat.olive .n { color: var(--olive); }

  /* Filters */
  .filters { display: flex; gap: 10px; margin-bottom: 16px; align-items: center; flex-wrap: wrap; }
  .filter-input {
    font-family: inherit; font-size: 13px;
    padding: 8px 12px; border: 1.5px solid var(--border);
    border-radius: 9px; background: var(--white); color: var(--text);
    min-width: 220px;
  }
  .filter-input:focus { outline: none; border-color: var(--olive); }
  .filter-select {
    font-family: inherit; font-size: 13px;
    padding: 8px 12px; border: 1.5px solid var(--border);
    border-radius: 9px; background: var(--white); color: var(--text);
  }
  .filter-select:focus { outline: none; border-color: var(--olive); }

  /* Table */
  .table-wrap { background: var(--white); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  thead { background: #f8faf4; }
  th { padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); border-bottom: 1px solid var(--border); }
  td { padding: 12px 16px; border-bottom: 1px solid #f0f4ea; color: var(--text); vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  tr.clickable { cursor: pointer; transition: background 0.1s; }
  tr.clickable:hover td { background: #f8fdf0; }

  /* Pill */
  .pill { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap; }
  .pill-active { background: #e8f5d8; color: #3a6e10; border: 1px solid #c0e090; }
  .pill-suspended { background: var(--amber-light); color: #8a5a00; border: 1px solid #f0d080; }
  .pill-new { background: var(--blue-light); color: #1a4db8; border: 1px solid #bfdbfe; }
  .pill-cc { background: var(--lime-light); color: var(--olive); border: 1px solid #c8e090; }
  .pill-private { background: #f3f0ff; color: #5b21b6; border: 1px solid #ddd6fe; }
  .pill-mixed { background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; }

  /* Hours bar */
  .hours-bar { display: flex; align-items: center; gap: 8px; }
  .bar-track { background: #eef2e8; border-radius: 4px; height: 6px; width: 80px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 4px; background: var(--lime); }
  .bar-fill.over { background: var(--coral); }
  .bar-fill.low { background: var(--amber); }

  /* Avatar stack */
  .carer-stack { display: flex; }
  .carer-av { width: 26px; height: 26px; border-radius: 50%; border: 2px solid #fff; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; color: #fff; margin-left: -6px; }
  .carer-av:first-child { margin-left: 0; }

  /* Alert row */
  .alert-row { background: #fffbf0; border: 1px solid #f0d878; border-radius: 10px; padding: 10px 16px; margin-bottom: 16px; font-size: 13px; color: #7a5500; display: flex; align-items: center; gap: 8px; }

  /* Drawer */
  .overlay { position: fixed; inset: 0; background: rgba(30,45,16,0.4); z-index: 100; display: none; }
  .overlay.open { display: block; }
  .drawer {
    position: fixed; top: 0; right: 0; height: 100%; width: 520px; max-width: 95vw;
    background: var(--white); z-index: 110;
    transform: translateX(100%); transition: transform 0.25s cubic-bezier(0.4,0,0.2,1);
    overflow-y: auto; box-shadow: -6px 0 24px rgba(0,0,0,0.12);
    display: flex; flex-direction: column;
  }
  .drawer.open { transform: translateX(0); }
  .drawer-head {
    background: var(--olive); padding: 20px 24px;
    display: flex; align-items: flex-start; justify-content: space-between;
    position: sticky; top: 0; z-index: 2;
  }
  .drawer-head-name { color: #fff; font-size: 20px; font-weight: 800; }
  .drawer-head-sub { color: rgba(255,255,255,0.7); font-size: 13px; margin-top: 2px; }
  .drawer-close { background: rgba(255,255,255,0.15); border: none; color: #fff; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 18px; flex-shrink: 0; }
  .drawer-body { padding: 22px 24px; flex: 1; }
  .drawer-tabs { display: flex; border-bottom: 2px solid var(--border); margin-bottom: 20px; }
  .drawer-tab { padding: 10px 16px; font-size: 13px; font-weight: 600; color: var(--muted); cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -2px; transition: all 0.15s; }
  .drawer-tab.active { color: var(--olive); border-bottom-color: var(--olive); }
  .drawer-section { display: none; }
  .drawer-section.active { display: block; }

  /* Info grid */
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
  .info-card { background: var(--bg); border-radius: 10px; padding: 12px 14px; }
  .info-card .k { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin-bottom: 4px; }
  .info-card .v { font-size: 14px; font-weight: 600; color: var(--text); word-break: break-word; }
  .info-card.full { grid-column: 1 / 3; }

  /* Care plan */
  .section-title { font-size: 13px; font-weight: 700; color: var(--olive); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 10px; }
  .visit-schedule { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
  .visit-row {
    background: var(--lime-light); border: 1px solid #c8e090; border-radius: 8px;
    padding: 10px 14px; display: flex; align-items: center; gap: 12px;
  }
  .visit-day { font-weight: 700; font-size: 13px; color: var(--olive); width: 90px; flex-shrink: 0; }
  .visit-time { font-size: 13px; color: var(--text); flex: 1; }
  .visit-duration { font-size: 12px; font-weight: 600; color: var(--muted); white-space: nowrap; }

  /* Tasks */
  .task-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
  .task-item { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text); }
  .task-check { width: 18px; height: 18px; border-radius: 4px; background: var(--lime-light); border: 1.5px solid var(--lime); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--olive); flex-shrink: 0; }

  /* Carer cards */
  .carer-cards { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .carer-card {
    background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 14px; display: flex; align-items: center; gap: 12px;
  }
  .carer-avatar-lg { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 14px; color: #fff; flex-shrink: 0; }
  .carer-info .name { font-weight: 700; font-size: 14px; }
  .carer-info .role { font-size: 12px; color: var(--muted); }
  .carer-lead { margin-left: auto; background: var(--lime-light); color: var(--olive); font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; }

  /* Alerts section */
  .alert-card { border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; font-size: 13px; display: flex; gap: 10px; }
  .alert-card.red { background: #fdf2f0; border: 1px solid #f5c0b8; color: #8a2010; }
  .alert-card.amber { background: var(--amber-light); border: 1px solid #f0d080; color: #7a5500; }
  .alert-card.green { background: var(--lime-light); border: 1px solid #c0e090; color: #3a6010; }

  /* Configr footer */
  .configr-bar {
    background: var(--olive); color: rgba(255,255,255,0.7);
    text-align: center; font-size: 12px; padding: 12px;
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 20;
  }
  .configr-bar strong { color: #fff; }
</style>
</head>
<body>

<!-- Top bar -->
<div class="topbar">
  <div class="brand">
    <div class="brand-logo">☕</div>
    <div class="brand-name">The Home Team<span>Care Management · Norwich</span></div>
  </div>
  <div class="topbar-nav">
