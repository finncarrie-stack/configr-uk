      <div class="d-section">Recent Visits</div>
      ${visitHtml}
      <div style="margin-top:8px;font-size:11px;color:var(--muted)">🟢 GPS dot = verified at service user's address. Timestamps locked on submission.</div>
      <div style="margin-top:16px;display:flex;gap:8px">
        <button class="btn btn-outline" onclick="closeDrawer()" style="flex:1">Close</button>
        ${d.flagNote?`<button class="btn btn-primary" style="flex:1">⚠ Edit Variance Note</button>`:`<button class="btn btn-green" style="flex:1">✓ Ready for export</button>`}
      </div>
    </div>`;

  document.getElementById('drawerOverlay').classList.add('open');
  document.getElementById('drawer').classList.add('open');
}

function closeDrawer() {
  document.getElementById('drawerOverlay').classList.remove('open');
  document.getElementById('drawer').classList.remove('open');
}
</script>
</body>
</html>
