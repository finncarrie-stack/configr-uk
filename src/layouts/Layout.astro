---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Workflow automation for small and medium businesses. No code. No complexity.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/brand_assets/configr_logo_large_800x240_1.png" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-slate-900 antialiased overflow-x-hidden">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
