---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { href: `${base}/#services`,     label: "Services" },
  { href: `${base}/#how-it-works`, label: "How it works" },
  { href: `${base}/#pricing`,      label: "Pricing" },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-white/88 backdrop-blur-lg border-b border-slate-100/70" style="box-shadow:0 1px 4px rgba(21,101,192,0.06);">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 flex items-center justify-between h-16">
    <a href={`${base}/`} class="flex-shrink-0 flex items-center gap-2.5">
      <div style="width:36px;height:36px;border-radius:10px;background:linear-gradient(140deg,#2176D2,#1565C0);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="3" fill="white"/>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.93 4.93l1.77 1.77M17.3 17.3l1.77 1.77M4.93 19.07l1.77-1.77M17.3 6.7l1.77-1.77" stroke="white" stroke-width="2" stroke-linecap="round"/>
          <circle cx="12" cy="12" r="5" stroke="white" stroke-width="1.5" fill="none"/>
        </svg>
      </div>
      <span style="font-size:20px;font-weight:800;color:#0F172A;letter-spacing:-0.03em;">Configr</span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link text-sm font-medium text-slate-600">{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href={`${base}/contact`} class="hidden md:block text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors duration-150 px-1">Contact</a>
      <a href={`${base}/contact`} class="btn-primary text-white text-sm font-semibold px-4 py-2 rounded-lg">Book a free call</a>
    </div>
  </div>
</header>
